{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ProjetoEDA",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/main",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/src",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Habilitar impressão de tipos",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Compilar ProjetoEDA",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}