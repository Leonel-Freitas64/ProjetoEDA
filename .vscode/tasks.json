{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar ProjetoEDA",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "mkdir -p bin && gcc -m64 -g -Wall -Wextra src/main.c src/Funções.c src/Binario.c src/Antenas.c src/Nefasto.c src/Mensagem.c -Iresources -o bin/main"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}